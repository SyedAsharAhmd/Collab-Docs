# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/collab_docs
# Used only by `npm test`; tables in this database are wiped between tests.
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/collab_docs_test
# Long random string, shared with collab/. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
